@startuml
actor "Пользователь" as User
participant "Telegram Bot" as Bot
participant "Функция retrieve()" as Retrieve
participant "FAISS индекс" as FAISS
participant "Модель эмбеддингов" as Embedder
participant "Функция generate_answer()" as Generate
participant "LLM (Ollama)" as LLM
participant "Лог-файл" as Log
participant "Скрипт оценки (evaluate.py)" as Eval

== Обработка запроса пользователя ==
User -> Bot: Вопрос
Bot -> Retrieve: retrieve(question, k=3)
Retrieve -> Embedder: model.encode([question])
Embedder --> Retrieve: query_vector
Retrieve -> FAISS: index.search(query_vector, k)
FAISS --> Retrieve: scores, indices
Retrieve -> Retrieve: Загрузка чанков из metadata.pkl
alt Чанки найдены (scores > 0)
    Retrieve --> Bot: docs (список чанков)
    Bot -> Generate: generate_answer(question, docs)
    Generate -> Generate: build_prompt(question, docs)
    Generate -> LLM: llm.invoke(prompt)
    LLM --> Generate: answer
    Generate --> Bot: answer
    Bot -> Log: log_query(question, docs, answer, "success")
    Bot --> User: Ответ с источниками
else Чанки не найдены (scores == 0)
    Retrieve --> Bot: docs = []
    Bot -> Bot: answer = "Я не знаю"
    Bot -> Log: log_query(question, [], answer, "failure")
    Bot --> User: "Я не знаю"
end

== Процесс оценки (evaluate.py) ==
Eval -> Eval: Загрузка golden_questions.json
loop Для каждого вопроса
    Eval -> Retrieve: retrieve(question, k=3)
    Eval -> Generate: generate_answer(question, docs)
    Eval -> Eval: actual_success = "Я не знаю" not in answer
    Eval -> Eval: is_correct = (actual_success == expected)
    Eval -> Log: Запись результата в evaluation_results.jsonl
end
Eval -> Eval: Подсчёт accuracy
Eval -> Eval: Сохранение evaluation_summary.json

== Возможные сбои ==
note right of FAISS
  **Сбой 1:**
  Индекс отсутствует или повреждён
  -> исключение, бот отвечает об ошибке
end note
note right of Generate
  **Сбой 2:**
  LLM не отвечает (Ollama не запущена)
  -> исключение, бот отвечает об ошибке
end note
note right of Embedder
  **Сбой 3:**
  Модель эмбеддингов не загружена
  -> исключение, бот отвечает об ошибке
end note
@enduml